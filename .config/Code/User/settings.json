  //     "commands": [
  //       "explorer.newFile"
  //     ],
  //   },
  // ],
  // "vim.visualModeKeyBindings": [
  //   {
  //     "before": [
  //       "<leader>",
  //       "/"
  //     ],
  //     "commands": [
  //       "editor.action.commentLine"
  //     ],
  //   },
  // ],
  "chat.agent.codeBlockProgress": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "window.menuBarVisibility": "toggle",
  "workbench.editor.enablePreview": false,
  "terminal.integrated.initialHint": false,
  // "chat.mcp.gallery.enabled": true,
  // "stitch.endpointUrl": "https://stitch.withgoogle.com/projects/8997798329185180817",
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "explorer.confirmPasteNative": false,
  "terminal.integrated.fontSize": 14,
  "java.help.showReleaseNotes": false,
  "chat.viewSessions.orientation": "stacked",
  "chat.tips.enabled": false,
  "chat.mcp.gallery.enabled": true,
  "workbench.browser.showInTitleBar": true,
  "workbench.editor.useModal": "some",
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.activityBar.compact": true,
  "claudeCode.preferredLocation": "panel",
  "vsicons.dontShowNewVersionMessage": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
}
